const CANVAS_API_BASE = 'https://canvastify.delitefully.com';

const TRACK_CACHE = {};
const PREFETCH_QUEUE = {};

const safeJsonFetch = (url) => {
    return fetch(url)
        .then(res => (res && res.ok) ? res.json() : null)
        .catch(() => null);
};

const parseTrackId = (input) => {
    if (!input || typeof input !== 'string') return '';

    const raw = input.trim();
    if (!raw) return '';

    const uriMatch = raw.match(/^spotify:track:([A-Za-z0-9]+)$/i);
    if (uriMatch) return uriMatch[1];

    const urlMatch = raw.match(/spotify\.com\/track\/([A-Za-z0-9]+)/i);
    if (urlMatch) return urlMatch[1];

    const clean = raw.replace(/\?.*$/, '').replace(/#.*/, '');
    if (/^[A-Za-z0-9]{10,40}$/.test(clean)) return clean;

    return '';
};

const fetchTrackCanvas = (trackId) => {
    const url = CANVAS_API_BASE + '/api/canvas/' + encodeURIComponent(trackId);

    return safeJsonFetch(url).then(json => {
        if (!json || typeof json !== 'object') return '';
        if (json.success === true && typeof json.canvas_url === 'string' && json.canvas_url) {
            return json.canvas_url;
        }
        return '';
    });
};

const _fetchTrackVisual = (maybeTrackId) => {
    const trackId = parseTrackId(maybeTrackId);
    const cacheKey = String(maybeTrackId || '');

    if (!trackId) return Promise.resolve('');
    if (cacheKey in TRACK_CACHE) return Promise.resolve(TRACK_CACHE[cacheKey]);

    return fetchTrackCanvas(trackId)
        .then(result => {
            TRACK_CACHE[cacheKey] = result || '';
            return TRACK_CACHE[cacheKey];
        })
        .catch(() => {
            TRACK_CACHE[cacheKey] = '';
            return '';
        });
};

return {
    id: 'spotify-canvas-scraper',
    name: 'Spotify Canvas v6',
    version: '6.0.0',
    description: 'Spotify Canvas via canvastify /api/canvas/:trackId',

    getSpotifyCanvas: (trackId) => _fetchTrackVisual(trackId),

    getAnimatedArtwork: (trackIdOrAlbumId) => _fetchTrackVisual(trackIdOrAlbumId),

    prefetchSpotifyCanvas: (trackId) => {
        const cacheKey = String(trackId || '');
        if (!trackId || (cacheKey in TRACK_CACHE) || PREFETCH_QUEUE[cacheKey]) return;

        PREFETCH_QUEUE[cacheKey] = _fetchTrackVisual(trackId)
            .finally(() => { delete PREFETCH_QUEUE[cacheKey]; });
    },

    prefetchAnimatedArtwork: (trackIdOrAlbumId) => {
        const cacheKey = String(trackIdOrAlbumId || '');
        if (!trackIdOrAlbumId || (cacheKey in TRACK_CACHE) || PREFETCH_QUEUE[cacheKey]) return;

        PREFETCH_QUEUE[cacheKey] = _fetchTrackVisual(trackIdOrAlbumId)
            .finally(() => { delete PREFETCH_QUEUE[cacheKey]; });
    },

    clearCache: () => {
        Object.keys(TRACK_CACHE).forEach(k => delete TRACK_CACHE[k]);
    }
};
